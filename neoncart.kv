#:import C theme.C
#:import I theme.I
#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window
#:import escape_markup kivy.utils.escape_markup

# ---------------------------------------------------------------- base
<IconLabel>:
    text: self.icon
    font_name: app.icon_font
    font_size: "20sp"
    size_hint: None, None
    size: self.texture_size

<IconButton>:
    text: self.icon
    font_name: app.icon_font
    font_size: "22sp"
    color: self.icon_color if not self.disabled else C.purple900
    disabled_color: C.purple900
    size_hint: None, None
    size: dp(42), dp(42)
    canvas.before:
        Color:
            rgba: self.hover_bg if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<SectionLabel@Label>:
    font_size: "11sp"
    bold: True
    color: C.purple400
    size_hint_y: None
    height: dp(18)
    text_size: self.width - dp(4), None
    halign: "left"
    padding: dp(4), 0

<NeonInput>:
    multiline: False
    write_tab: False
    background_normal: ""
    background_active: ""
    background_color: C.field
    foreground_color: C.pink100
    cursor_color: C.pink500
    selection_color: (0.93, 0.28, 0.6, 0.3)
    hint_text_color: C.hint
    font_size: "17sp"
    padding: [dp(46) if self.icon else dp(16), (self.height - self.line_height) / 2, dp(16), 0]
    size_hint_y: None
    height: dp(52)
    canvas.after:
        Color:
            rgba: C.pink500 if self.focus else C.border
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1.5) if self.focus else dp(1)

<GradientButton>:
    size_hint_y: None
    height: dp(56)
    padding: dp(16), 0
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: (1, 0.45, 0.75, 0.35)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, 0
            blur_radius: dp(18)
            border_radius: [dp(12)] * 4
        Color:
            rgba: (0.85, 0.85, 0.85, 1) if self.state == "down" else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
            texture: self.texture
    Widget:
    IconLabel:
        icon: root.icon
        color: C.white
        pos_hint: {"center_y": .5}
    Label:
        text: root.text
        bold: True
        font_size: "15sp"
        color: C.white
        size_hint_x: None
        width: self.texture_size[0]
    Widget:

<Card@BoxLayout>:
    orientation: "vertical"
    canvas.before:
        Color:
            rgba: (0, 0, 0, 0.5)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, 0
            blur_radius: dp(15)
            border_radius: [dp(16)] * 4
        Color:
            rgba: C.card
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: C.border
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))

# ---------------------------------------------------------------- tela principal
<Root>:
    canvas.before:
        Color:
            rgba: C.bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(16), dp(16), dp(12)
        spacing: dp(14)

        # Cabeçalho
        BoxLayout:
            size_hint_y: None
            height: dp(76)
            padding: dp(16), dp(12)
            spacing: dp(14)
            canvas.before:
                Color:
                    rgba: (0.66, 0.33, 0.97, 0.2)
                BoxShadow:
                    pos: self.pos
                    size: self.size
                    offset: 0, 0
                    blur_radius: dp(20)
                    border_radius: [dp(16)] * 4
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]
                    texture: app.grad_header
                Color:
                    rgba: C.border_soft
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            AnchorLayout:
                size_hint_x: None
                width: dp(52)
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0.4)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]
                    Color:
                        rgba: (0.93, 0.28, 0.6, 0.3)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
                IconLabel:
                    icon: I.cart
                    font_size: "30sp"
                    color: C.pink400
            BoxLayout:
                orientation: "vertical"
                Label:
                    text: "NEON CART"
                    bold: True
                    font_size: "24sp"
                    color: C.pink300
                    text_size: self.size
                    halign: "left"
                    valign: "bottom"
                Label:
                    text: "CONTROLE DE ESTOQUE"
                    bold: True
                    font_size: "11sp"
                    color: C.purple300
                    text_size: self.size
                    halign: "left"
                    valign: "top"

        # Formulário
        Card:
            size_hint_y: None
            height: self.minimum_height
            padding: dp(18)
            spacing: dp(6)

            SectionLabel:
                text: "SETOR / DIVISÓRIA"
            NeonInput:
                id: division
                icon: I.grid
                hint_text: "Ex: SETOR-X"
                uppercase: True
                on_text_validate: code.focus = True

            Widget:
                size_hint_y: None
                height: dp(6)
            SectionLabel:
                text: "IDENTIFICAÇÃO DO CARRINHO"
            RelativeLayout:
                size_hint_y: None
                height: dp(52)
                NeonInput:
                    id: code
                    icon: I.cart
                    hint_text: "CÓDIGO..."
                    uppercase: True
                    font_name: "RobotoMono-Regular"
                    foreground_color: C.pink300
                    padding: [dp(46), (self.height - self.line_height) / 2, dp(56), 0]
                    pos: 0, 0
                    on_text_validate: app.submit()
                IconButton:
                    icon: I.camera
                    icon_color: C.pink600
                    hover_bg: (0.51, 0.09, 0.26, 0.3)
                    pos: self.parent.width - self.width - dp(6), (self.parent.height - self.height) / 2
                    on_release: app.open_scanner()

            Widget:
                size_hint_y: None
                height: dp(6)
            BoxLayout:
                size_hint_y: None
                height: dp(18)
                SectionLabel:
                    text: "OBSERVAÇÃO  [color=#9333eab3][size=10sp](Opcional)[/size][/color]"
                    markup: True
            NeonInput:
                id: observation
                icon: I.message
                hint_text: "Ex: Roda quebrada..."
                font_size: "14sp"
                height: dp(46)
                on_text_validate: app.submit()

            Widget:
                size_hint_y: None
                height: dp(10)
            GradientButton:
                icon: I.plus
                text: "PROCESSAR DADOS"
                texture: app.grad_main
                on_release: app.submit()

        # Busca
        NeonInput:
            id: search
            icon: I.search
            hint_text: "Buscar código, divisória ou obs..."
            font_size: "15sp"
            height: dp(48) if app.total else 0
            opacity: 1 if app.total else 0
            disabled: not app.total
            background_color: C.card
            on_text: app.search_query = self.text

        # Lista
        Card:
            BoxLayout:
                size_hint_y: None
                height: dp(54)
                padding: dp(14), 0, dp(8), 0
                spacing: dp(6)
                canvas.before:
                    Color:
                        rgba: C.field
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16), dp(16), 0, 0]
                    Color:
                        rgba: C.border
                    Line:
                        points: self.x, self.y, self.right, self.y
                IconLabel:
                    icon: I.history
                    color: C.pink400
                    font_size: "18sp"
                    pos_hint: {"center_y": .5}
                Label:
                    text: "LOG DE REDE"
                    bold: True
                    color: C.pink400
                    font_size: "14sp"
                    size_hint_x: None
                    width: self.texture_size[0]
                Label:
                    text: "{}{}".format(app.visible, " / {}".format(app.total) if app.search_query else "")
                    color: C.pink300
                    font_size: "12sp"
                    size_hint: None, None
                    size: self.texture_size[0] + dp(14), dp(22)
                    pos_hint: {"center_y": .5}
                    canvas.before:
                        Color:
                            rgba: (0.51, 0.09, 0.26, 0.4)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(6)]
                        Color:
                            rgba: (0.93, 0.28, 0.6, 0.3)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
                Widget:
                IconButton:
                    icon: I.share
                    disabled: not app.total
                    hover_bg: (0.08, 0.33, 0.18, 0.3)
                    pos_hint: {"center_y": .5}
                    on_release: app.share()
                IconButton:
                    icon: I.download
                    disabled: not app.total
                    hover_bg: (0.51, 0.09, 0.26, 0.3)
                    pos_hint: {"center_y": .5}
                    on_release: app.export()
                IconButton:
                    icon: I.trash
                    disabled: not app.total
                    hover_bg: (0.5, 0.11, 0.11, 0.3)
                    pos_hint: {"center_y": .5}
                    on_release: app.clear_all()

            FloatLayout:
                RecycleView:
                    id: rv
                    viewclass: "EntryRow"
                    pos: self.parent.pos
                    size: self.parent.size
                    bar_width: dp(6)
                    bar_color: C.purple900
                    bar_inactive_color: (0.35, 0.11, 0.53, 0.4)
                    scroll_type: ["bars", "content"]
                    RecycleBoxLayout:
                        orientation: "vertical"
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height

                BoxLayout:
                    orientation: "vertical"
                    pos: self.parent.pos
                    size: self.parent.size
                    opacity: 1 if app.visible == 0 else 0
                    padding: dp(20)
                    spacing: dp(10)
                    Widget:
                    IconLabel:
                        icon: I.cart if app.total == 0 else I.search
                        font_size: "48sp" if app.total == 0 else "32sp"
                        color: (0.42, 0.13, 0.66, 0.5) if app.total == 0 else (0.58, 0.2, 0.92, 0.5)
                        pos_hint: {"center_x": .5}
                    Label:
                        text: "SISTEMA VAZIO" if app.total == 0 else "NENHUM RESULTADO"
                        font_name: "RobotoMono-Regular"
                        font_size: "13sp"
                        color: C.purple800 if app.total == 0 else C.purple600
                        size_hint_y: None
                        height: dp(24)
                    Widget:

    # Alerta de código duplicado (fica escondido acima da tela)
    DuplicateAlert:
        id: dup_alert
        size_hint: None, None
        width: min(root.width * 0.9, dp(380))
        height: dp(76)
        center_x: root.center_x
        y: root.top + dp(100)
        opacity: 0

# ---------------------------------------------------------------- linha da lista
<EntryRow>:
    padding: dp(16), dp(12)
    spacing: dp(8)
    canvas.after:
        Color:
            rgba: (0.35, 0.11, 0.53, 0.3)
        Line:
            points: self.x, self.y, self.right, self.y
    BoxLayout:
        orientation: "vertical"
        spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(30)
            spacing: dp(8)
            Label:
                text: root.code
                font_name: "RobotoMono-Regular"
                bold: True
                font_size: "18sp"
                color: C.pink200
                size_hint_x: None
                width: min(self.texture_size[0], self.parent.width - dp(50))
                text_size: None, None
                shorten: True
            Label:
                text: root.time
                font_name: "RobotoMono-Regular"
                font_size: "10sp"
                color: C.purple700
                size_hint_x: None
                width: self.texture_size[0]
            Widget:
        BoxLayout:
            size_hint_y: None
            height: dp(24)
            spacing: dp(6)
            Label:
                text: "LOC:"
                font_size: "10sp"
                color: C.purple600
                size_hint_x: None
                width: self.texture_size[0]
            Label:
                text: root.division
                font_size: "12sp"
                color: C.pink400
                size_hint_x: None
                width: min(self.texture_size[0] + dp(16), self.parent.width - dp(40))
                shorten: True
                canvas.before:
                    Color:
                        rgba: (0.51, 0.09, 0.26, 0.2)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(6)]
                    Color:
                        rgba: (0.93, 0.28, 0.6, 0.2)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
            Widget:
        Label:
            text: "[b][color=#a855f7]OBS:[/color][/b] " + escape_markup(root.observation)
            markup: True
            font_size: "12sp"
            color: (0.98, 0.66, 0.83, 0.8)
            opacity: 1 if root.observation else 0
            size_hint_y: None
            height: (self.texture_size[1] + dp(16)) if root.observation else 0
            text_size: self.width - dp(16), None
            padding: dp(8), dp(8)
            canvas.before:
                Color:
                    rgba: (0.35, 0.11, 0.53, 0.2) if root.observation else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8)]
        Widget:
    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: dp(44)
        spacing: dp(4)
        IconButton:
            icon: I.edit
            icon_color: C.purple500
            hover_bg: (0.12, 0.23, 0.54, 0.3)
            on_release: app.edit_entry(root.entry_id)
        IconButton:
            icon: I.trash2
            icon_color: C.purple800
            hover_bg: (0.5, 0.11, 0.11, 0.3)
            on_release: app.remove_entry(root.entry_id)
        Widget:

# ---------------------------------------------------------------- alerta
<DuplicateAlert>:
    padding: dp(14)
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: (0.94, 0.27, 0.27, 0.5)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, 0
            blur_radius: dp(30)
            border_radius: [dp(16)] * 4
        Color:
            rgba: C.red_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: C.red500
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(2)
    AnchorLayout:
        size_hint_x: None
        width: dp(46)
        canvas.before:
            Color:
                rgba: (0.5, 0.11, 0.11, 0.4)
            Ellipse:
                pos: self.x, self.center_y - dp(23)
                size: dp(46), dp(46)
        IconLabel:
            icon: I.alert
            font_size: "24sp"
            color: C.red500
    BoxLayout:
        orientation: "vertical"
        Label:
            text: "CÓDIGO DUPLICADO!"
            bold: True
            font_size: "14sp"
            color: C.red500
            text_size: self.size
            halign: "left"
            valign: "middle"
        Label:
            text: "Carrinho [b][color=#ffffff]" + escape_markup(root.code) + "[/color][/b] já registrado."
            markup: True
            font_name: "RobotoMono-Regular"
            font_size: "12sp"
            color: C.red200
            text_size: self.size
            halign: "left"
            valign: "middle"
            shorten: True

# ---------------------------------------------------------------- janelas
<ModalTitle@BoxLayout>:
    icon: ""
    text: ""
    size_hint_y: None
    height: dp(44)
    spacing: dp(8)
    IconLabel:
        icon: root.icon
        font_size: "24sp"
        color: C.pink500
        pos_hint: {"center_y": .5}
    Label:
        text: root.text
        bold: True
        font_size: "17sp"
        color: C.pink100
        text_size: self.size
        halign: "left"
        valign: "middle"

<CloseButton@IconButton>:
    icon: I.close
    icon_color: C.pink300
    pos_hint: {"center_y": .5}
    canvas.before:
        Color:
            rgba: (0.35, 0.11, 0.53, 0.5)
        Ellipse:
            pos: self.pos
            size: self.size

<ModalCard@BoxLayout>:
    orientation: "vertical"
    padding: dp(22)
    spacing: dp(8)
    size_hint: None, None
    width: min(Window.width - dp(32), dp(380))
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: (0.93, 0.28, 0.6, 0.3)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, 0
            blur_radius: dp(30)
            border_radius: [dp(16)] * 4
        Color:
            rgba: C.card
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: (0.93, 0.28, 0.6, 0.5)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))

<EditModal>:
    background: ""
    background_color: C.overlay
    overlay_color: (0, 0, 0, 0)
    size_hint: 1, 1
    auto_dismiss: True
    AnchorLayout:
        ModalCard:
            BoxLayout:
                size_hint_y: None
                height: dp(44)
                ModalTitle:
                    icon: I.edit
                    text: "EDITAR DADOS"
                CloseButton:
                    on_release: root.dismiss()
            Widget:
                size_hint_y: None
                height: dp(8)
            SectionLabel:
                text: "CÓDIGO"
            NeonInput:
                id: code
                uppercase: True
                font_name: "RobotoMono-Regular"
                foreground_color: C.pink300
                on_text_validate: division.focus = True
            SectionLabel:
                text: "DIVISÓRIA"
            NeonInput:
                id: division
                uppercase: True
                on_text_validate: observation.focus = True
            SectionLabel:
                text: "OBSERVAÇÃO"
            NeonInput:
                id: observation
                on_text_validate: root.submit()
            Widget:
                size_hint_y: None
                height: dp(10)
            GradientButton:
                icon: I.save
                text: "SALVAR ALTERAÇÕES"
                texture: app.grad_alt
                on_release: root.submit()

<ConfirmModal>:
    background: ""
    background_color: C.overlay
    overlay_color: (0, 0, 0, 0)
    size_hint: 1, 1
    AnchorLayout:
        ModalCard:
            ModalTitle:
                icon: I.alert
                text: root.title
            Label:
                text: root.message
                color: C.pink100
                font_size: "15sp"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] + dp(16)
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)
                Button:
                    text: "CANCELAR"
                    bold: True
                    background_normal: ""
                    background_color: (0.35, 0.11, 0.53, 0.5)
                    color: C.pink300
                    on_release: root.dismiss()
                Button:
                    text: root.confirm_text
                    bold: True
                    background_normal: ""
                    background_color: (0.86, 0.15, 0.15, 0.85)
                    color: C.white
                    on_release: root.confirm()

<InfoModal>:
    background: ""
    background_color: C.overlay
    overlay_color: (0, 0, 0, 0)
    size_hint: 1, 1
    AnchorLayout:
        ModalCard:
            ModalTitle:
                icon: root.icon
                text: root.title
            Label:
                text: root.message
                color: C.pink100
                font_size: "15sp"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] + dp(16)
            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)
                Button:
                    text: "OK"
                    bold: True
                    background_normal: ""
                    background_color: (0.35, 0.11, 0.53, 0.5)
                    color: C.pink300
                    on_release: root.dismiss()
                Button:
                    text: root.action_text
                    bold: True
                    disabled: not root.action_text
                    opacity: 1 if root.action_text else 0
                    size_hint_x: 1 if root.action_text else 0.001
                    background_normal: ""
                    background_color: (0.86, 0.15, 0.47, 0.85)
                    color: C.white
                    on_release: root.action()

# ---------------------------------------------------------------- câmera
<ScannerModal>:
    background: ""
    background_color: C.overlay
    overlay_color: (0, 0, 0, 0)
    size_hint: 1, 1
    auto_dismiss: True
    AnchorLayout:
        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            width: min(Window.width - dp(32), dp(380))
            height: self.minimum_height
            spacing: dp(20)
            BoxLayout:
                size_hint_y: None
                height: dp(44)
                ModalTitle:
                    icon: I.camera
                    text: "SCAN CYBER"
                CloseButton:
                    on_release: root.dismiss()

            RelativeLayout:
                size_hint_y: None
                height: self.width
                canvas.before:
                    Color:
                        rgba: (0.93, 0.28, 0.6, 0.2)
                    BoxShadow:
                        pos: 0, 0
                        size: self.size
                        offset: 0, 0
                        blur_radius: dp(30)
                        border_radius: [dp(24)] * 4
                    Color:
                        rgba: (0.02, 0.02, 0.02, 1)
                    RoundedRectangle:
                        pos: 0, 0
                        size: self.size
                        radius: [dp(24)]
                StencilView:
                    id: preview_box
                    pos: dp(2), dp(2)
                    size: self.parent.width - dp(4), self.parent.height - dp(4)
                    on_size: root._layout_camera()
                    on_pos: root._layout_camera()
                Label:
                    text: root.status
                    font_name: "RobotoMono-Regular"
                    font_size: "13sp"
                    color: (0.66, 0.33, 0.97, 0.6)
                # Mira
                Widget:
                    size_hint: .75, .5
                    pos_hint: {"center_x": .5, "center_y": .5}
                    canvas:
                        Color:
                            rgba: C.pink500
                        Line:
                            points: self.x, self.top - dp(32), self.x, self.top, self.x + dp(32), self.top
                            width: dp(2.5)
                        Line:
                            points: self.right - dp(32), self.top, self.right, self.top, self.right, self.top - dp(32)
                            width: dp(2.5)
                        Color:
                            rgba: C.purple500
                        Line:
                            points: self.x, self.y + dp(32), self.x, self.y, self.x + dp(32), self.y
                            width: dp(2.5)
                        Line:
                            points: self.right - dp(32), self.y, self.right, self.y, self.right, self.y + dp(32)
                            width: dp(2.5)
                        Color:
                            rgba: C.pink500
                        Line:
                            points: self.x, self.center_y, self.right, self.center_y
                            width: dp(1)
                Widget:
                    canvas:
                        Color:
                            rgba: (0.66, 0.33, 0.97, 0.5)
                        Line:
                            rounded_rectangle: (0, 0, self.parent.width, self.parent.height, dp(24))
                            width: dp(1.5)

            BoxLayout:
                size_hint: None, None
                height: dp(50)
                width: self.minimum_width
                pos_hint: {"center_x": .5}
                spacing: dp(14)
                Button:
                    text: "[font={}]{}[/font]  FLASH".format(app.icon_font, I.flash if root.torch_on else I.flash_off)
                    markup: True
                    font_name: "RobotoMono-Regular"
                    font_size: "14sp"
                    size_hint_x: None
                    width: dp(130)
                    background_normal: ""
                    background_color: (0.86, 0.15, 0.47, 0.4) if root.torch_on else (0.35, 0.11, 0.53, 0.4)
                    color: C.pink100 if root.torch_on else C.pink300
                    on_release: root.toggle_torch()
                Button:
                    text: "[font={}]{}[/font]  LENTE".format(app.icon_font, I.switch)
                    markup: True
                    font_name: "RobotoMono-Regular"
                    font_size: "14sp"
                    size_hint_x: None
                    width: dp(130) if root.camera_total > 1 else 0
                    opacity: 1 if root.camera_total > 1 else 0
                    disabled: root.camera_total < 2
                    background_normal: ""
                    background_color: (0.35, 0.11, 0.53, 0.4)
                    color: C.pink300
                    on_release: root.switch_camera()

            Label:
                text: "ALVO REQUERIDO: CÓDIGO DE BARRAS"
                font_name: "RobotoMono-Regular"
                font_size: "11sp"
                color: C.purple400
                size_hint_y: None
                height: dp(20)
